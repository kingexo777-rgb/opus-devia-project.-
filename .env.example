# =============================================================================
# Opus Devia — AI model secrets (SERVER ONLY)
# =============================================================================
# Copy to `.env.local` for local Edge Function development.
# For production: set these in Supabase Dashboard → Project Settings → Edge Functions → Secrets
# NEVER commit `.env.local` or paste keys into chat logs / git.
#
# Each block: API_KEY + BASE_URL + MODEL (where applicable)

# ── 1. Mentor — DeepSeek V4 Pro ──────────────────────────────────────────────
MENTOR_API_KEY=
MENTOR_BASE_URL=
MENTOR_MODEL=

# ── 2. Assistant — Gemini 2.0 Flash ────────────────────────────────────────
ASSISTANT_API_KEY=
ASSISTANT_BASE_URL=
ASSISTANT_MODEL=

# ── 3. Reviews / roadmap generation — Gemini 2.5 Flash ───────────────────────
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=

# ── 4. Background jobs — DeepSeek V4 Flash ─────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# ── 5. Voice output — OpenAI TTS (tts-1, voice onyx) ─────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Alias also accepted: OPENAI_API_BASE_URL=
# TTS model/voice are fixed in governance — not overridable via env for safety

# ── 6. Voice input — OpenAI Whisper (mentor sessions only) ───────────────────
OPENAI_2_API_KEY=
OPENAI_2_BASE_URL=
# Alias also accepted: OPENAI_2_API_BASE_URL= (falls back to OPENAI_BASE_URL)
# OPENAI_WHISPER_MODEL=whisper-1 (fixed in code)

# Base URL aliases (either naming works for providers 1–4):
# MENTOR_API_BASE_URL, ASSISTANT_API_BASE_URL, GEMINI_API_BASE_URL, DEEPSEEK_API_BASE_URL

# ── Supabase (Edge Functions — usually auto-injected in production) ──────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Required once to push secrets via scripts/push-secrets-from-env.ps1:
# SUPABASE_ACCESS_TOKEN=
