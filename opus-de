import { Link } from "react-router-dom";

interface RoadmapBarProps {
  completionPercentage: number;
  loading: boolean;
}

export default function RoadmapBar({ completionPercentage, loading }: RoadmapBarProps) {
  if (loading) {
    return (
      <div className="mx-4 z-10">
        <div className="glass-card roadmap-card animate-pulse" />
      </div>
    );
  }

  const clamped = Math.min(100, Math.max(0, completionPercentage));
  const rounded = Math.round(clamped);
  // Placeholder values for the status bar
  const phaseName = "PHASE II";
  const phaseLabel = "EXECUTION";
  const daysRemaining = 18;

  return (
    <div className="mx-4 z-10">
      <div className="glass-card roadmap-card">
        {/* Upper section */}
        <div className="roadmap-upper">
          <div>
            <div className="roadmap-label">ROADMAP</div>
            <div className="roadmap-percent">{rounded}%</div>
          </div>
          <div className="roadmap-right">
            <span className="milestones">2 of 6 Milestones</span>
            <Link to="/roadmap" className="roadmap-link">
              VIEW ROADMAP
            </Link>
          </div>
        </div>

        {/* Progress track */}
        <div className="progress-track">
          <div className="progress-fill" style={{ width: `${clamped}%` }} />
        </div>

        {/* Bottom status */}
        <div className="roadmap-status">
          <div className="current-phase">
            <div className="phase-dot" />
            <span className="phase-text">{phaseName} · {phaseLabel}</span>
          </div>
          <span className="phase-eta">{daysRemaining} DAYS REMAINING</span>
        </div>
      </div>
    </div>
  );
}